# Staging: un solo dominio, sin landing. Aquí se prueba la plataforma, no se vende nada.
# Un único sitio evita que Caddy reciba dos bloques para el mismo nombre de host.
{$WINOPO_DOMINIO:staging.winopo.es} {
	encode zstd gzip

	handle /v1/* {
		reverse_proxy core:8080
	}

	handle /healthz {
		reverse_proxy core:8080
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
