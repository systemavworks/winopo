# WinOpo · copia a .env y rellena. Nada de secretos en el repositorio.

# Base de datos
POSTGRES_DB=winopo
# POSTGRES_USER es el superusuario del contenedor: solo sirve para administrar y migrar.
POSTGRES_USER=winopo
POSTGRES_PASSWORD=cambiame
# Usuario con el que se conecta la aplicación. Sin superusuario y sin BYPASSRLS:
# es lo que hace que el aislamiento entre preparadores (RLS) se aplique de verdad.
# En el servidor, generar con: openssl rand -hex 24
POSTGRES_APP_PASSWORD=cambiame_app
# El driver JDBC necesita jdbc: y las credenciales como parametros (ver core/db/Database.kt)
DATABASE_URL=jdbc:postgresql://localhost:5432/winopo?user=winopo_app&password=cambiame_app

# Servidor
PORT=8080
APP_ENV=local
APP_BASE_URL=http://localhost:3000
# Dominios: el apex sirve el landing, el subdominio sirve la plataforma.
WINOPO_DOMINIO=winopo.es
WINOPO_APP_DOMINIO=app.winopo.es
# Esquema interno del edge: http cuando el TLS lo termina Cloudflare (túnel, caja compartida),
# https cuando Caddy saca el certificado por HTTP-01 (caja dedicada, WINOPO_EDGE=propia).
WINOPO_SCHEME=http
# Token del Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels -> winopo-cax11).
# Obligatorio en producción sobre la caja compartida: sin él cloudflared no arranca.
TUNNEL_TOKEN=
# Minimo 32 caracteres. Generar con: openssl rand -base64 48
SESSION_SECRET=

# Objetos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=winopo-media

# IA
IA_PROVEEDOR=
IA_API_KEY=
IA_MODELO=
IA_PRESUPUESTO_MENSUAL_CENTS=6000

# Voz y vídeo
TTS_PROVEEDOR=
TTS_API_KEY=

# Pagos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo
SMTP_URL=
CORREO_REMITENTE=no-reply@winopo.es
