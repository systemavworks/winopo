{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winopo.es/contracts/ia/correccion.schema.json",
  "title": "Propuesta de corrección por IA",
  "description": "Lo que el modelo puede devolver: puntos por apartado. Nunca nota final ni clave de test.",
  "type": "object",
  "required": ["items", "observaciones"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["codigo", "puntos_cents", "justificacion"],
        "additionalProperties": false,
        "properties": {
          "codigo": { "type": "string", "pattern": "^[A-Z0-9_.-]{1,40}$" },
          "puntos_cents": { "type": "integer", "minimum": 0 },
          "justificacion": { "type": "string", "minLength": 10, "maxLength": 2000 }
        }
      }
    },
    "observaciones": { "type": "string", "maxLength": 4000 },
    "confianza": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
